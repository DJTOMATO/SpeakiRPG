{
  "name": "SpeakiRPG",
  "version": "1.2.0",
  "description": "Speaki RPG with Discord Rich Presence integration",
  "main": "main.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:win:arm64": "electron-builder --win --arm64 --config.nsis.oneClick=false --config.nsis.allowToChangeInstallationDirectory=true --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "electron",
    "discord",
    "rich presence"
  ],
  "author": "Glas",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "discord-rpc": "*"
  },
  "devDependencies": {
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.glas.speakirpg",
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "zip"
        }
      ],
      "icon": "icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpeakiRPG",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Utility",
      "maintainer": "Glas <48269777+DJTOMATO@users.noreply.github.com>"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "node_modules/**/*",
      "SpeakiMod.js",
      "injector.js",
      "erpin.html"
    ]
  }
}
