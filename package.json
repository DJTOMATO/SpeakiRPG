{
  "name": "SpeakiRPG",
  "version": "1.0.8",
  "description": "Speaki RPG with Discord Rich Presence integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "electron",
    "discord",
    "rich presence"
  ],
  "author": "Glas",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.4.0",
    "discord-rpc": "*"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.glas.speakirpg",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "node_modules/**/*",
      "SpeakiMod.js",
      "injector.js"
    ]
  }
}
